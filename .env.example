# 本地密钥（本仓库里默认没有 .env 文件，需要你自己新建）
# 任选其一：
#   A) 复制本文件：cp .env.example backend/.env   然后编辑 backend/.env 填入 AMAP_WEB_KEY
#   B) 在仓库根目录新建文件 .env，写入 AMAP_WEB_KEY=你的key
# Cursor 里：左侧点进 backend 文件夹 → 新建文件 → 文件名填 .env（前面有点）
# 填好后重启：cd backend && npm start

# 高德 Web 服务 Key（地理编码、路径规划、POI 搜索等）
AMAP_WEB_KEY=

# 百度地图服务端 AK（步行路线规划；本仓库从 Node 后端请求，见 README「百度」说明）
BAIDU_MAP_AK=

# 将高德 POI 写入 SQLite attractions（npm run sync-amap）同样需要 AMAP_WEB_KEY

# 可选：POI 搜索默认城市
AMAP_CITY=上海

# 可选：智能行程 LLM（经 FAI 网关；若只在 backend/.env 配置，可忽略此处）
# FAI_LLM_API_KEY=fai-2-***-******
# LLM_MODEL=gemini-2.5-pro
