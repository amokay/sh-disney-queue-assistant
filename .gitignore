# 前端原始资源（只本地）
frontend/assets/models/source/
frontend/assets/textures/source/

# 历史目录（若仍存在）
assets/models/source/
assets/textures/source/

# 后端本地数据库
backend/db/*.db

# 依赖
node_modules/

# 系统文件
.DS_Store
Thumbs.db

# Blender 自动备份
*.blend1
*.blend2

# 日志
*.log

# 大型生成数据（前端由脚本生成，不需要索引）
frontend/assets/data/park_roads.json

# 3D 二进制模型（仅忽略 source 目录下的原始模型）
frontend/assets/models/source/*.glb
tools/*_source.glb

# 构建与本地环境
dist
.env
.env.local
.env.*.local
.gstack/
