# 高德 Web 服务 Key（步行规划 / POI 搜索；控制台创建「Web 服务」应用，开通“路线规划 / 步行”）
# 复制本文件为同目录下的 `.env` 后填写，不要提交 `.env`
# 在终端执行：cp backend/.env.example backend/.env
# 或用 Cursor：在 backend 文件夹上右键 → 新建文件 → 文件名输入 .env

AMAP_WEB_KEY=9bab5c7c3c71bbfcb9bfddc57ba36534

# 百度地图 AK（步行规划接口；需控制台启用「服务端」应用 + 开通「路线规划 / 步行」+ 配置 IP 白名单，见 README）
BAIDU_MAP_AK=

# 可选：智能行程 LLM — 经集团 FAI 网关（OpenAI 兼容），不配则使用默认两行建议
# 本地/日常域名基址（代码已默认，一般不必改）：https://trip-llm.alibaba-inc.com/api/fai/v1
#
# FAI_LLM_API_KEY：必须是 FAI/trip-llm 应用令牌（通常 fai-2- 开头），不是 Google Gemini 网页 API Key。
# 若报「应用校验失败 / app validation failed」，说明填错了密钥类型。
# FAI_LLM_API_KEY=fai-2-你的令牌
# LLM_BASE_URL=https://trip-llm.alibaba-inc.com/api/fai/v1
# LLM_MODEL=gemini-2.5-pro
#
# 步行路线：baidu-then-amap（默认，百度失败自动高德）| baidu | amap
# WALK_ROUTE_PROVIDER=baidu-then-amap

# 可选：POI 搜索默认城市
AMAP_CITY=上海

# 可选：启动时 glb_poi_bindings 同步 — SKIP_SYNC_GLB_POI=1 整段跳过；SKIP_SYNC_GLB_POI_ATTRACTION_DB=1 只跳过写 attractions（仍更新 model_transforms）

# 一键把「主流迪士尼 POI 关键词表」写入 SQLite：在项目根执行 npm run sync-amap-popular
