    {
      "_名称": "幻想曲旋转木马",
      "matchGlb": "fantasia-carousel",
      "applyToAllMeshes": true,
      "props": { "unlit": true, "emissiveIntensity": 0.72 }
    },
    {
      "_名称": "七个小矮人矿山车",
      "matchGlb": "seven-dwarfs-mine-train",
      "applyToAllMeshes": true,
      "props": { "unlit": true, "emissiveIntensity": 1.2 }
    },
    {
      "_名称": "加勒比海盗",
      "matchGlb": "caribbean-pirates",
      "applyToAllMeshes": true,
      "props": { "unlit": true, "emissiveIntensity": 1.2 }
    },
    {
      "_名称": "地面",
      "matchGlb": "ground",
      "applyToAllMeshes": true,
      "props": { "unlit": true, "emissiveIntensity": 1.2 }
    },
    {
